# Copy to backend/.env for local overrides (this file is only documentation).
# NEVER commit a real .env file. Hosting dashboards (Render/Supabase) inject
# these values automatically; locally the app falls back to the defaults.
#
# Option A (hosted DB like Supabase): single connection string wins when set.
# DATABASE_URL=postgresql://postgres:PASTE-PASSWORD@db.xxxx.supabase.co:5432/postgres
#
# Option B (local DB): individual parts, defaults shown (local Postgres on 5433).
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=ulpin_db
#
# Auth signing key: MUST be set to a long random string on any hosted deploy.
# JWT_SECRET=change-me-to-a-long-random-string
#
# Comma-separated frontend address(es) allowed to call the API.
# Local dev needs no setup (localhost:5173 always allowed).
# Hosted: set to the live site, e.g. FRONTEND_URL=https://aakaar.vercel.app
# FRONTEND_URL=http://localhost:5173
